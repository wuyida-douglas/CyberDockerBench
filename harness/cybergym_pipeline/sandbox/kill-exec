#!/bin/bash
set -Eeuo pipefail

[[ $# -eq 1 && "$1" =~ ^[0-9a-f]{32}$ ]]
record=/run/cybergym-exec/$1
[[ -r "$record.pid" ]] || exit 0
read -r pid < "$record.pid"
[[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]]
# Refuse malformed/non-session records instead of ever signalling a broad or
# dockerd process group. cybergym-exec uses setsid, so its child PGID == PID.
pgid=$(ps -o pgid= -p "$pid" | tr -d ' ')
sid=$(ps -o sid= -p "$pid" | tr -d ' ')
[[ "$pgid" == "$pid" && "$sid" == "$pid" ]]
kill -TERM -- "-$pid" 2>/dev/null || true
for _ in 1 2 3 4 5; do
    kill -0 "$pid" 2>/dev/null || exit 0
    sleep 1
done
kill -KILL -- "-$pid" 2>/dev/null || true
