#!/bin/bash
set -Eeuo pipefail

[[ $# -eq 1 && "$1" =~ ^[0-9a-f]{32}$ ]]
record=/run/cdb-exec/$1
[[ -r "$record.pid" ]] || exit 0
read -r pid < "$record.pid"
[[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]]
# Refuse broad or malformed targets. cdb-exec uses setsid: child PGID == PID.
pgid=$(ps -o pgid= -p "$pid" | tr -d ' ')
sid=$(ps -o sid= -p "$pid" | tr -d ' ')
[[ "$pgid" == "$pid" && "$sid" == "$pid" ]]
kill -TERM -- "-$pid" 2>/dev/null || true
for _ in 1 2 3 4 5; do
    state=$(ps -o stat= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    # A zombie is dead; kill -0 stays true until its parent reaps it. Never
    # report that cleanup failed just because a TERM'd shell is now a zombie.
    [[ -z "$state" || "$state" == Z* ]] && exit 0
    sleep 1
done
kill -KILL -- "-$pid" 2>/dev/null || true
